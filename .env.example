DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,django

DATABASE_URL=postgres://platform:platform@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
USE_REDIS=true

# llama.cpp HTTP server (OpenAI-compatible). Django never loads GGUF — only this URL.
LLAMA_CPP_BASE_URL=http://llamacpp:8080

# vLLM HTTP server (OpenAI-compatible).
VLLM_BASE_URL=http://vllm:8000
# Default backend for inference requests when not explicitly specified.
DEFAULT_INFERENCE_BACKEND=llamacpp

# FastAPI gateway: persist redacted rows to inference_inferencerequestlog (same DB as Django).
GATEWAY_PERSIST_LOGS=true

# Prefer a dedicated pepper for API key hashing (falls back to SECRET_KEY if empty).
API_KEY_HMAC_PEPPER=

# Readiness checks (compose should enable llama readiness once the runtime is stable).
READINESS_INCLUDE_LLAMA=false

# Prometheus scrape auth (optional). If set, /metrics requires Authorization: Bearer <token>.
METRICS_SCRAPE_TOKEN=

# Never enable in shared environments — stores prompts in DB.
DEBUG_LOG_FULL_PROMPTS=false

# Inference request log retention (purge via `manage.py purge_inference_logs`).
LOG_RETENTION_DAYS=30

# Max JSON body size for inference endpoints (bytes).
INFERENCE_MAX_REQUEST_BODY_BYTES=2000000

# Upstream llama.cpp HTTP timeouts (seconds).
INFERENCE_UPSTREAM_TIMEOUT_S=600

# Generation controls — defaults applied server-side
INFERENCE_DEFAULT_MAX_TOKENS=128
INFERENCE_HARD_MAX_TOKENS=512
INFERENCE_DEFAULT_TEMPERATURE=0.7
INFERENCE_DEFAULT_TOP_P=0.9

# Concurrency / backpressure
INFERENCE_MAX_CONCURRENCY=4
INFERENCE_QUEUE_SIZE=10
INFERENCE_QUEUE_TIMEOUT_S=30.0

# Prompt safeguards — reject prompts exceeding this character count
INFERENCE_MAX_PROMPT_CHARS=100000

# Browser CSRF/CORS (comma-separated origins), e.g. https://app.example.com
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Correlation / request ID header from edge (optional)
REQUEST_ID_HEADER=X-Request-ID

# Logging
LOG_LEVEL=INFO

# ── RAG / Retrieval-Augmented Generation ─────────────────────────────────────
RAG_ENABLED=true
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_MAX_CONTEXT_CHARS=8000
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
